{
  "manifest_version": 3,
  "name": "ACAI WebHMI Collector",
  "version": "6.0",
  "description": "Собирает показания с WebHMI и отправляет на сервер ACAI",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://192.168.1.74/*",
    "https://91-147-113-239.sslip.io/*",
    "http://localhost:8000/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://192.168.1.74/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ACAI Collector"
  }
}
