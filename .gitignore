ДОСТУП_ПЕРСОНАЛ.txt

# Фото продукции и участков, загруженные через сайт. Лежат ВНУТРИ
# папки с кодом (frontend/static/uploads) — и поэтому их легко и
# закоммитить по ошибке, и стереть выкладкой. В репозиторий им нельзя
# по той же причине, что и остальным рабочим файлам.
frontend/static/uploads/

# Вложения из переписки: фото шильдиков, видео узлов, акты. Это
# рабочие данные, им место в бэкапе, а не в репозитории — иначе он
# распухнет на гигабайты и утащит переписку сотрудников в открытый
# доступ вместе с кодом.
uploads/

# HTTPS-сертификат сервера (закрытый ключ — не в репозиторий)
certs/

# Рабочие снимки экрана (39 файлов, 10 МБ). Делаются на КОПИИ боевой
# базы, поэтому на них настоящие фамилии, логины и должности
# сотрудников. Репозиторий уезжает на GitHub — там им не место.
# Нужны они только для проверки вёрстки и живут на машине разработчика.
theme/
