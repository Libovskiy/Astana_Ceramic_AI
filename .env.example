# Образец настроек ACAI. Скопировать в .env и заполнить:
#     cp .env.example .env
#
# Сам .env в git не попадает (см. .gitignore) — в нём живые пароли
# и ключи. Здесь только имена переменных и пояснения.


# ── Обязательное ─────────────────────────────────────────

# Подпись сессий. Любая длинная случайная строка, своя на каждой
# установке. Сменить = разлогинить всех.
ACAI_SECRET_KEY=

# Ключ OpenAI для ответов ИИ по обращениям.
OPENAI_API_KEY=

# Логины владельцев системы через запятую. Им доступны бэкапы,
# восстановление и удаление защищённых данных, а их учётки нельзя
# отключить через веб.
OWNERS=alibek


# ── Приём показаний с датчиков ────────────────────────────

# Ключ, которым расширение в браузере подписывает показания
# (заголовок X-Sensor-Key). Без него в историю производства сможет
# писать кто угодно из заводской сети. Если пусто — проверка
# отключается, чтобы сбор данных не встал молча.
SENSOR_PUSH_KEY=

# Панель WebHMI (массаподготовка). Нужно ТОЛЬКО серверному сборщику,
# то есть при ACAI_WEBHMI_COLLECTOR=1. Расширение в браузере работает
# по сессии сотрудника и пароль не использует.
ACAI_WEBHMI_COLLECTOR=0
ACAI_WEBHMI_URL=
ACAI_WEBHMI_LOGIN=
ACAI_WEBHMI_PASS=


# ── Режим работы ─────────────────────────────────────────

# НЕ МЕНЯТЬ на production, пока завод работает по HTTP.
# От этой строки зависит только флаг secure у cookie входа: при
# production браузер отправляет cookie лишь по HTTPS, и вход в систему
# перестанет работать молча — человек вводит верный пароль и остаётся
# на странице логина. Менять можно одновременно с переездом на HTTPS.
ENVIRONMENT=development


# ── База знаний (ChromaDB) ───────────────────────────────

ACAI_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
ACAI_COLLECTION=factory_manuals_ml


# ── Необязательное ───────────────────────────────────────

# С какого месяца считать график ТО, формат ГГГГ-ММ.
ACAI_MAINTENANCE_START=

# Сколько часов обращение считается активным (по умолчанию в config.py).
ACTIVE_CASE_WINDOW_HOURS=

# Максимум шагов диагностики у ИИ за одно обращение.
MAX_AI_STEPS=

# Домены, которым разрешены запросы к API, через запятую.
ALLOWED_ORIGINS=

# Путь к базе мониторинга, если она лежит не рядом с проектом.
ACAI_MONITORING_DB=
