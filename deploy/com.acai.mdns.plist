<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.acai.mdns</string>

    <!-- Держит в сети постоянное имя сайта acai.local.
         Цифры адреса меняются, имя — нет: по нему заходят телефоны,
         ноутбуки и компьютеры цеха, и на него же выписан сертификат. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/champ_01/Documents/FactoryAssistant/venv/bin/python</string>
        <string>/Users/champ_01/Documents/FactoryAssistant/scripts/admin/mdns_alias.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/champ_01/Documents/FactoryAssistant</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- Пропала сеть или процесс упал — поднимаем снова. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/champ_01/Documents/FactoryAssistant/logs/mdns.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/champ_01/Documents/FactoryAssistant/logs/mdns.log</string>
</dict>
</plist>
